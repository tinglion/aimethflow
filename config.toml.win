# 甲基化分析项目配置文件
# 项目名称
name = "甲基化分析项目"
version = "1.0.0"

# 数据目录配置
[data]
# 根数据目录
root_dir = "/mnt/f/meth"
# 组织样本数据目录
tissue_dir = "/mnt/f/meth/OC_tissue"
# 血浆样本数据目录
plasma_dir = "/mnt/f/meth/OC_plasma"
# 样本信息Excel文件路径
sample_info_excel = "data/卵巢癌fq编号与样本信息对应表v3.xlsx"
# 探针区域文件路径
probe_panel_bed = "data/panel_B10308.bed"
# 候选区域文件路径
candidate_regions = "data/OC_tissue_88_regions.hg38.txt"

# 目录配置
[directories]
# 临时文件目录
temp_dir = "temp"
# 结果文件目录
result_dir = "result"
# 日志文件目录
log_dir = "logs"

# FastQ分析配置
[fastq]
# 每处理多少条序列显示进度
progress_interval = 1000000
# 抽样大小
sample_size = 1000
# 随机种子
random_seed = 42

# 甲基化提取配置
[extraction]
# 最小甲基化质量分数
min_quality = 20
# 最小覆盖深度
min_depth = 10
# 参考基因组路径
reference_genome = "/data/meth/bwa/hg38.fa"

# 差异甲基化分析配置
[diff_methylation]
# 甲基化差异阈值
threshold = 0.2
# 统计显著性水平
p_value = 0.05
# 最小覆盖深度
min_depth = 20

# 可视化配置
[visualization]
# 图表类型: density, scatter, heatmap
plot_types = ["density", "scatter", "heatmap"]
# 图表宽度
fig_width = 12
# 图表高度
fig_height = 8
# DPI
dpi = 300
# 字体大小
font_size = 12

# 甲基化数据过滤配置
[filtering]
# 重复序列BED文件路径
repeat_bed = "/mnt/f/meth/hg38.repeat.bed"
# 启动子区域BED文件路径
promoter_bed = "/mnt/f/meth/hg38_upstream_2k_st.bed.gz"
# 最小深度
min_depth = 5
# 最大深度
max_depth = 50

# 血浆cfDNA靶向甲基化分析配置
[plasma]
# 比对工具: "bismark"（精准，慢，首次验证/需要OT-OB方向性报告时用）
#            "bwameth"（快3-5倍，推荐100+样本批量分析）
aligner = "bwameth"
# UMI设置（R2 5'端6N）
umi_length = 6
umi_location = "read2"
# Trimming参数
trim_front1 = 12        # R1 5'端切除碱基数（低复杂度寡核苷酸）
trim_front2 = 12        # R2 5'端切除碱基数（UMI提取后的寡核苷酸）
trim_tail2 = 5          # R2 3'端切除碱基数（poly-C偏差，根据M-bias图调整）
min_length = 35         # 过滤后最短read长度
min_quality = 20        # 最低碱基质量Q值
# 比对参数
non_directional = false # 单链建库方向性（待M-bias确认后调整）
# MethylDackel extract 位置偏差校正（根据 M-bias 图调整，格式: "R1_5',R1_3',R2_5',R2_3'"）
# 0,0,0,0 = 不截；建议先看 mbias SVG 再填写
nOT = "0,0,0,20"        # OT链（M-bias建议: 0,0,0,111 → 先保持0，确认SVG后再调整）
nOB = "0,0,17,0"        # OB链（M-bias建议: 0,0,17,0  → 先保持0，确认SVG后再调整）
# 比对质量过滤
min_mapq = 40
# 区域覆盖深度过滤
min_cpg_per_region = 3
min_reads_per_region = 5
# 甲基化read阈值（策略B，与tissue统一）
methylated_read_threshold = 0.60
low_confidence_threshold = 0.40
# 差异分析阈值
diff_p_value = 0.05
diff_delta_beta = 0.10

# 并行线程/进程配置（所有步骤的多线程数均在此统一管理）
[threads]
# fastp 质控线程数
fastp = 8
# bwameth/bwa-mem 比对线程数
bwameth = 8
# samtools sort 线程数（-@ 参数，实际用线程 = sort_threads + 1）
samtools_sort = 4
# samtools sort 每线程内存限制
samtools_sort_mem = "8G"
# MethylDackel 线程数（mbias / extract）
methyldackel = 4
# umi_tools dedup 不支持多线程，此配置预留
umi_tools = 1

# 工具路径配置
[tools]
# conda meth 环境的 bin 目录（非交互式bash中PATH不含conda env，需显式指定）
conda_env_bin = "/mnt/e/programs/ubuntu/miniconda3/envs/meth/bin"
# umi_tools 备用路径（如果meth env中没有，回退到base env）
umi_tools_fallback = "/mnt/e/programs/ubuntu/miniconda3/bin/umi_tools"

# 中间文件清理策略（各步骤完成后是否删除上一步产物）
# 默认全部保留，节省重跑成本；磁盘紧张时可按需开启
[cleanup]
# dedup 完成后，删除 align 生成的排序 BAM（*.bwameth_pe.sorted.bam）
delete_after_dedup = false
# target 完成后，删除 dedup 生成的 BAM（*.dedup.bam）
delete_after_target = false

# 机器学习分类器配置（Step 14 特征选择 + Step 15 诊断分类）
[ml]
# 特征选择模式: "union"（LASSO和RF并集，默认）/ "lasso" / "rf"
feature_selection_mode = "union"
# 最低覆盖率阈值：DMC位点在 ≥ 此比例的样本中有覆盖才保留（0~1）
min_feature_coverage = 0.5
# 样本级 Wilcoxon 预筛选阈值（在 LASSO/RF 之前，过滤合并 bedGraph 产生的假性高 |Δβ| 位点）
# diff_methylation.txt 是对合并组 bedGraph 比较的结果，组内噪声被平均掉会虚高 |Δβ|。
# 这里用个体样本层面的 Mann-Whitney U 检验作二次筛选。
sample_wilcox_p   = 0.05   # p 值阈值（非 88 区域位点，标准）0.05
sample_delta_beta = 0.10   # 样本级 |Δβ| 阈值（非 88 区域位点，标准）
sample_wilcox_p_88   = 0.05   # p 值阈值（88 组织候选区域内位点，宽松先验）
sample_delta_beta_88 = 0.1   # |Δβ| 阈值（88 组织候选区域内位点，宽松先验）
# 分类器最大输入特征数（0 = 不限制；建议设为 n_samples/10 左右防止过拟合）
# 120样本 → 建议 10~20；超过限制时按 LASSO+RF 综合评分保留 top-N
max_features_clf = 20
# LASSO (L1 logistic) 交叉验证折数
lasso_cv_folds = 5
# 随机森林树数量（特征选择 + 分类均使用）
rf_n_estimators = 500
# RF 最小特征重要性阈值（0 = 保留所有重要性 > 0 的特征）
rf_min_importance = 0.0
# 逻辑回归正则化参数 C（越大越弱正则化）
lr_C = 1.0
# SVM 正则化参数 C
svm_C = 1.0
# XGBoost 参数
xgb_n_estimators = 200
xgb_max_depth = 4
xgb_learning_rate = 0.1
# LightGBM 参数
lgbm_n_estimators = 200
lgbm_max_depth = 4
lgbm_learning_rate = 0.1
# 样本异常检测参数
# 样本最低覆盖率：CpG 有覆盖的位点比例 < 此值时触发覆盖率异常标记
outlier_coverage_min = 0.30
# PCA 组内距离 z-score 阈值：超过此值触发 PCA 异常标记
outlier_pca_z = 2.5
# Panel 位点 ≥10x 测序深度的最低样本覆盖比例（低于此值的位点从最终 Panel 中强制移除）
min_10x_coverage_rate = 0.80
# 确认排除的样本 ID（在查看 outlier_report.csv 后填写）
exclude_samples = ['B10013', 'B10022', 'B10018', 'B10268']

# Feature site annotation configuration (Step 17)
[annotation]
# EWAS Catalog search window around each CpG site (bp)
ewas_window = 500
# Ensembl gene overlap window around each site (bp)
gene_window = 2000
# Delay between API calls (seconds) — respect rate limits
api_delay = 0.25
# Request timeout (seconds)
api_timeout = 15
# Path to local hg38 CpG island BED file (leave empty to auto-download from UCSC)
cpgi_bed = ""
# EWAS Atlas (CNCB NGDC) — query positional associations
ewas_atlas = true
# PubMed E-utilities — search gene + "plasma methylation cancer"
pubmed_search = true
# NCBI API key (optional; increases rate limit from 3→10 req/s; leave empty to omit)
ncbi_api_key = "4abb0ffcf184c006f41fde521b7f7266cb09"
# Max PubMed results to retrieve per gene
pubmed_max_hits = 20

# 日志配置
[logging]
# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
level = "INFO"
# 日志格式
format = "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
# 是否保存到文件
save_to_file = true
# 是否输出到控制台
console_output = true
