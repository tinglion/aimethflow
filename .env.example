METH_WORKDIR=.

# 外部数据路径（宿主机绝对路径）
DATA_DIR=/data/meth/data
TISSUE_DIR=/data/meth/OC_tissue
PLASMA_DIR=/data/meth/OC_plasma
REF_DIR=/data/meth/ref
TEMP_DIR=/data/meth/temp
RESULT_DIR=/data/meth/result

# Docker 专用配置文件（路径使用容器内 /mnt/...，见 config.docker.toml）
CONFIG_FILE=./config.docker.toml

# Jupyter notebook 目录（留空则用项目根下的 ./notebooks）
NOTEBOOKS_DIR=./notebooks

# 可选：PubMed API Key
NCBI_API_KEY=
